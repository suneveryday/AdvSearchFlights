# Copy this file to .env or export these variables in your shell.
# Never commit real credentials.

FLIGHT_PROVIDER=auto

# Google Flights / fli
FLI_QUERY_CURRENCY=USD
FLI_LANGUAGE=en-US
FLI_COUNTRY=US
FLI_TIMEOUT_SECONDS=15
FLIGHT_USD_CNY_RATE=7.2

# Optional Skyscanner experimental fallback
SKYSCANNER_LOCALE=en-US
SKYSCANNER_MARKET=US
SKYSCANNER_CURRENCY=USD
SKYSCANNER_RETRY_DELAY=2
SKYSCANNER_MAX_RETRIES=6
