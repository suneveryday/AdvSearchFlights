# Copy this file to .env or export these variables in your shell.
# Never commit real credentials.

FLIGHT_PROVIDER=auto

# Google Flights / fli
FLI_QUERY_CURRENCY=USD
FLI_LANGUAGE=en-US
FLI_COUNTRY=US
FLI_TIMEOUT_SECONDS=15
FLIGHT_USD_CNY_RATE=7.2

# Amadeus fallback
AMADEUS_CLIENT_ID=YOUR_AMADEUS_CLIENT_ID
AMADEUS_CLIENT_SECRET=YOUR_AMADEUS_CLIENT_SECRET
AMADEUS_HOST=https://test.api.amadeus.com
